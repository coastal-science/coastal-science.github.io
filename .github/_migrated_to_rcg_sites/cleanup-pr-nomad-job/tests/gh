#!/usr/bin/env bash
# Stub gh for find-closed-pr.sh tests.
# GH_STUB_PAYLOAD: JSON to print (empty = no PR).
set -euo pipefail

if [ "${1:-}" != "api" ]; then
  echo "gh stub: expected api, got: $*" >&2
  exit 1
fi

if [ -n "${GH_STUB_FAIL:-}" ]; then
  echo "gh stub: induced failure" >&2
  exit 1
fi

printf '%s\n' "${GH_STUB_PAYLOAD:-}"
exit 0
